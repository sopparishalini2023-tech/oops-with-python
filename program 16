class shape:
    def area(self):
        print("area of the shape")
class circle(shape):
    def area(self):
        r=3
        print("area of circle:",3.14*r*r)
class rectangle(shape):
    def area(self):
        l=5
        b=5
        print("area of rectangle:",l*b)
class triangle(shape):
    def area(self):
        base=6
        height=8
        print("area of triangle:",0.5*base*height)
c=circle()
r=rectangle()
t=triangle()
print(c.area())
print(r.area())
print(t.area())
